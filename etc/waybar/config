{
    "layer": "top",
    "position": "bottom",
    "height": 30,

    "modules-left": ["sway/workspaces", "sway/mode", "wlr/taskbar", "sway/window"],
    "modules-center": ["custom/mypipe"],
    "modules-right": ["custom/imggallery", "custom/screenshot", "custom/volume", "battery", "bluetooth", "network", "cpu", "memory", "clock", "tray"],


    "clock": {
        "timezone": "Europe/Stockholm",
        "format": "{:%Y-%m-%d %H:%M}",
		"tooltip-format": "<span font='14'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>v.{:%V}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699' background='#333333'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },



    "battery": {
         "format": "{capacity}% {icon}",
         "format-icons": ["<", " ", " ", " ", " "]
    },


    "cpu": {
        "format": "{usage}% ",
        "tooltip": true
    },


    "memory": {
        "format": "{}% "
    },


    "keyboard-state": {
	"numlock": true,
	"capslock": true,
	"format": " {name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },



    "tray": {
    "format": "󱊕 ",
	"icon-size": 20,
	"spacing": 10
    },



    "network": {
		"format-wifi": "{essid} ({signalStrength}%)    ",
        "format-ethernet": "   ",
        "format-disconnected": "   ",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)\nInterface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-disconnected": "Inget nätverk anslutet",
		"format-wifi": "{essid} ({signalStrength}%) {icon}",
		"format-ethernet": "{ifname} {ipaddr} {icon}",
		"format-disconnected": "Inget nätverk {icon}",
		"format-icons": ["󰯡 ", "󰈀 ", "󰖩 "]
    },



    "custom/mypipe": {
        "format": "{}",
        "exec": "mkdir -p /tmp/waybar && [ ! -p /tmp/waybar/pipe ] && mkfifo /tmp/waybar/pipe; tail -n 1 -f /tmp/waybar/pipe",
        "tail": true
    },



    "custom/imggallery": {
        "format": " ",
        "tooltip": true,
        "tooltip-format": "Öppna bildgalleri (gThumb)",
        "on-click": "gthumb /home/void/Pictures"
    },



    "custom/volume": {
        "format": "{}",
        "return-type": "json",
        "exec": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{vol=int($2*100); if ($3==\"[MUTED]\") printf \"{\\\"text\\\":\\\"   %d%%\\\",\\\"class\\\":\\\"muted\\\"}\\n\", vol; else {icon=(vol==0?\"\":(vol<50?\"\":\" \")); printf \"{\\\"text\\\":\\\"%s %d%%\\\",\\\"class\\\":\\\"unmuted\\\"}\\n\", icon, vol}}'",
        "interval": 1,
        "signal": 10,
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+10 waybar",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -RTMIN+10 waybar",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+10 waybar",
        "on-click-right": "pavucontrol",
        "tooltip": false
    },



    "custom/screenshot": {
        "format": "󰄀 ",
		"icon-size": 30,
        "tooltip": true,
        "menu": "on-click",
        "menu-file": "/etc/waybar/screenshot_menu.xml", // Sökväg till din menyfil
        "menu-actions": {
			"shot_area": "bash /etc/waybar/grimshot_launcher.sh one",
			"shot_screen": "bash /etc/waybar/grimshot_launcher.sh two",
			"shot_window": "bash /etc/waybar/grimshot_launcher.sh three"
       }
   },


    "wlr/taskbar": {
	"format": "{icon}",
	"icon-size": 24,
	"on-click": "activate",
	"tooltip-format": "{title}"
    },


   "bluetooth": {
        "format": " {status}",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰥈 {device_alias} {device_battery_percentage}%",
        // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
   }


}



