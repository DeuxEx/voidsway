{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "clock"],

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}"
    },
    "cpu": {
        "format": "CPU: {usage}%"
    },
    "memory": {
        "format": "RAM: {}%"
    },
    "network": {
        "format-wifi": "WiFi: {essid}",
        "format-ethernet": "ETH: {ipaddr}",
        "format-disconnected": "Inget nätverk"
    },
    "pulseaudio": {
        "format": "Vol: {volume}%"
    }
}
