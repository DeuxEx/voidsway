{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    // HÄR: "custom/mypipe" har lagts till först i listan till höger
    "modules-left": ["sway/workspaces", "sway/mode", "custom/mypipe"],
    "modules-center": ["sway/window"],
    "modules-right": ["network", "cpu", "memory", "clock"],

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}"
    },
    "cpu": {
        "format": "CPU: {usage}%"
    },
    "memory": {
        "format": "RAM: {}%"
    },
    "network": {
        "format-wifi": "WiFi: {essid}",
        "format-ethernet": "ETH: {ipaddr}",
        "format-disconnected": "Inget nätverk"
    },
    "custom/mypipe": {
        "format": "{}",
        "exec": "mkdir -p /tmp/waybar && [ ! -p /tmp/waybar/pipe ] && mkfifo /tmp/waybar/pipe; cat /tmp/waybar/pipe",
        "restart-interval": 1
    }
}
