{
    "layer": "top",
    "position": "bottom",
    "height": 30,

    // HÄR: "custom/mypipe" har lagts till först i listan till höger
    "modules-left": ["sway/workspaces", "sway/mode", "wlr/taskbar", "sway/window"],
    "modules-center": ["custom/mypipe"],
    "modules-right": ["custom/screenshot", "bluetooth", "network", "cpu", "memory", "tray", "clock"],

    "clock": {
	"timezone": "Europe/Stockholm",
	//"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
	//"format-alt": "{:%Y-%m-%d}",
    "format": "{:%Y-%m-%d %H:%M}"
    },

    "cpu": {
        "format": "{usage}% ",
        "tooltip": true
    },

    "memory": {
        "format": "{}% "
    },

    "keyboard-state": {
	"numlock": true,
	"capslock": true,
	"format": " {name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },

    "sway/language": {
	"format": " {}",
    },

    "tray": {
	"icon-size": 20,
	"spacing": 10
    },

    "network": {
        "format-wifi": "Wifi: {essid}",
        "format-ethernet": "ETH: {ipaddr}",
        "format-disconnected": "Inget nätverk"
    },

     "backlight": {
        // "device": "acpi_video1",
        "format": "{icon}",
        "format-icons": ["", ""],
        "on-click": "bash $HOME/.config/system_scripts/brightness up",
        "on-click-right": "bash $HOME/.config/system_scripts/brightness down",
        "on-scroll-up": "",
        "on-scroll-down": ""
    },

    "custom/mypipe": {
        "format": "{}",
        "exec": "mkdir -p /tmp/waybar && [ ! -p /tmp/waybar/pipe ] && mkfifo /tmp/waybar/pipe; cat /tmp/waybar/pipe",
        "restart-interval": 1
    },


    "custom/screenshot": {
        "format": "📷",
        "tooltip": true,
        "menu": "on-click",
        "menu-file": "/etc/waybar/screenshot_menu.xml", // Sökväg till din menyfil
        "menu-actions": {
        "shot_area": "grimshot --notify savecopy area $HOME/Pictures/$(zenity --entry --text 'Set filename:' --entry-text '.png')",     // Välj region/område manuellt

		//"shot_area": "grimshot --notify savecopy area $HOME/Pictures/$(date +%Y_%m_%d_%k%M_%N '.png')",     // Välj region/område manuellt


        "shot_screen": "grimshot --notify savecopy screen $HOME/Pictures/$(zenity --entry --text 'Set filename:' --entry-text '.png')", // Hela skärmen
        "shot_window": "grimshot --notify savecopy window $HOME/Pictures/$(zenity --entry --text 'Set filename:' --entry-text '.png')"  // Ett specifikt fönster
       }
   },

    "wlr/taskbar": {
	"format": "{icon}",
	"icon-size": 24,
	"on-click": "activate",
	"tooltip-format": "{title}"
    },


           "bluetooth": {
                "format": "<U+F294> {status}",
                "format-connected": "<U+F294> {device_alias}",
                "format-connected-battery": "<U+F294> {device_alias} {device_battery_percentage}%",
                // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
                "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
                "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
                "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
                "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
           }




}

